---
export interface CardProps {
  title: string;
  description: string;
}
const {title,description} = Astro.props as CardProps;
---
<div class="card bg-neutral text-neutral-content mt-2 w-96">
  <div class="card-body items-center text-center">
    <h2 class="card-title">{title}</h2>
    <p>{description}</p>
    
  </div>
</div>